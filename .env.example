PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voice_ai
DB_SYNC=true
DB_SSL=false

OPENAI_API_KEY=sk-your-key
REALTIME_PROVIDER=openai
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_BASE_URL=https://api.openai.com/v1/realtime/calls
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VAD_EAGERNESS=auto

GEMINI_API_KEY=your-gemini-key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_TEMPERATURE=0.7
GEMINI_LIVE_THINKING_LEVEL=low

MEMORY_EXTRACT_PROVIDER=gemini
MEMORY_EXTRACT_MODEL=gpt-5.4-nano
GEMINI_MEMORY_MODEL=gemini-2.5-flash
MEMORY_ENCRYPTION_KEY=replace-with-32-plus-random-characters

APP_ORIGIN=http://localhost:3001
